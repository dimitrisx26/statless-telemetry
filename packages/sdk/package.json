{
  "name": "statless-telemetry",
  "version": "0.1.0",
  "description": "Zero-dependency, cookie-free usage telemetry for developer CLIs and npm packages. Opt-out aware, no IPs stored, works standalone or self-hosted.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "telemetry",
    "usage-analytics",
    "analytics",
    "cli",
    "npm",
    "node",
    "privacy",
    "privacy-first",
    "cookie-free",
    "gdpr",
    "do-not-track",
    "opt-out",
    "self-hosted",
    "instrumentation",
    "developer-tools",
    "statless"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dimitrisx26/statless-telemetry.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/dimitrisx26/statless-telemetry/issues"
  },
  "homepage": "https://github.com/dimitrisx26/statless-telemetry#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
